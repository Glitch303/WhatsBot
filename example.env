ASSISTANT_NAME=EvakkoBotti
ADMIN_NUMBERS=+358123456789
MAX_MESSAGES=5

# Reply whitelist: only these numbers get AI responses
# Use "*" for everyone, or comma-separated numbers
REPLY_WHITELIST=*

# Reply toggles are controlled at runtime (not via env):
#   - Self-chat:  !replies self_chat <on|off>   (default ON)
#   - DM:         !replies dm <on|off>          (default OFF)
#   - Group @:    !replies group_mention <on|off> (default OFF)
#   - Group (always): OFF (hardcoded, not toggleable)
#   - Terminal:   "replies <group_mention|dm|self_chat> <on|off>"
#   - Status:     !status  or  "status"

# LLM Provider: "openai" | "azure" | "openrouter" | "llamacpp"
LLM_PROVIDER=azure

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Azure OpenAI ---
AZURE_ENDPOINT=https://xxx.openai.azure.com/
AZURE_DEPLOYMENT_NAME=gpt-4.1-nano
AZURE_SUBSCRIPTION_KEY=xxx
AZURE_API_VERSION=2024-12-01-preview

# --- OpenRouter ---
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini

# --- llama.cpp / llama-swap (local OpenAI-compatible server) ---
# llama-swap: http://localhost:27906/v1 (auto-loads models on demand)
# llama-server: http://localhost:8080/v1 (single model)
# LLAMACPP_BASE_URL=http://localhost:27906/v1
# LLAMACPP_MODEL=Qwen3.8-Orca-27B-Instruct
