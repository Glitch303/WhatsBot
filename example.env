# Persona: the bot's character lives in SOUL.md (gitignored).
# Copy SOUL.example.md to SOUL.md and edit it. It is re-read on every
# message, so edits apply live without a restart.

# Owner identity: who gets the bot's private face.
# (Set your own name — it is injected into the system prompt.)
OWNER_NAME=YourName
# Recommended: exact phone match (international format, no +).
# When unset, the owner is matched by pushname instead.
# OWNER_NUMBER=628123456789

ADMIN_NUMBERS=+628123456789

# Reply whitelist: only these numbers get AI responses
# Use "*" for everyone, or comma-separated numbers
REPLY_WHITELIST=*

# Reply toggles are controlled at runtime (not via env):
#   - Self-chat:  !replies self_chat <on|off>    (default ON)
#   - DM:         !replies dm <on|off>           (default ON)
#   - Group:      !replies group_mention <on|off> (default OFF)
#     ON  = shared group session: every group message is recorded as context,
#           the bot only speaks when @mentioned
#     OFF = groups are ignored entirely
#   - Terminal:   "replies <group_mention|dm|self_chat> <on|off>"
#   - Status:     !status  or  "status"

# Session / memory (optional):
# SESSION_GAP_SECONDS=3600   # silence gap (s) before a message counts as a new session
# VERBATIM_TURNS=10          # recent user turns kept verbatim in context; older ones summarized
# MEMORY_CUTOFF_DAYS=30      # prune messages older than this
# FACT_CUTOFF_DAYS=60        # prune facts unconfirmed for longer than this
# MAX_FACTS_IN_CONTEXT=8     # max facts injected into the system prompt
# MAX_REPLY_TOKENS=500       # hard token cap per LLM reply

# LLM Provider: "openai" | "azure" | "openrouter" | "llamacpp"
LLM_PROVIDER=azure

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Azure ---
AZURE_ENDPOINT=https://xxx.openai.azure.com/
AZURE_DEPLOYMENT_NAME=gpt-4.1-nano
AZURE_SUBSCRIPTION_KEY=xxx
AZURE_API_VERSION=2024-12-01-preview

# --- OpenRouter ---
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini

# --- llama.cpp / llama-swap (local OpenAI-compatible server) ---
# llama-swap: http://localhost:27950/v1 (auto-loads models on demand)
# llama-server: http://localhost:8080/v1 (single model)
# LLAMACPP_BASE_URL=http://localhost:8080/v1
# LLAMACPP_MODEL=your-model-name
